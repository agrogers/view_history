<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_users_form_view_history" model="ir.ui.view">
            <field name="name">res.users.form.view.history</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='preferences']//group[@name='preferences']" position="inside">
                    <group string="View History">
                        <field name="log_view_history"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_users_form_simple_modif_view_history" model="ir.ui.view">
            <field name="name">res.users.preferences.view.history</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='preferences_page']//group[@name='preferences']" position="inside">
                    <group string="View History">
                        <field name="log_view_history"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
