<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_model_form_view_history" model="ir.ui.view">
        <field name="name">ir.model.form.view.history</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="View History">
                    <field name="view_history_icon" widget="image" options="{'size': [32, 32]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>